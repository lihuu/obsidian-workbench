{
  "name": "obsidian-workbench",
  "version": "0.1.7",
  "description": "Manage projects and agent tasks on a local-first kanban board.",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "svelte-check --tsconfig tsconfig.json && tsc --noEmit && node esbuild.config.mjs production",
    "check": "svelte-check --tsconfig tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "runner": "node runner/server.mjs",
    "deploy": "npm run build && node scripts/deploy.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "esbuild-svelte": "^0.9.0",
    "obsidian": "1.14.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.1.0",
    "svelte-dnd-action": "^0.9.80",
    "svelte-preprocess": "^6.0.3",
    "typescript": "^5.8.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  }
}
